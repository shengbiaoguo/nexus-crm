# Copy with pnpm env:init. Local placeholders are NOT usable credentials.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true
# Authentication remains unavailable until configured. Generate 32 random bytes encoded as base64url.
# AUTH_JWT_SECRET=<replace-with-a-cryptographically-random-43-character-base64url-secret>
# Use a dedicated, least-privileged LOCAL MySQL 8.4 account; URL-encode credentials.
DATABASE_URL=mysql://nexus:replace_me@127.0.0.1:3306/nexus_crm
REDIS_URL=redis://127.0.0.1:6379/0
