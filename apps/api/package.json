{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && node ../../scripts/dev-api.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:db": "tsc -p tsconfig.test.json && node --test dist-test/test/database/*.test.js",
    "db:verify": "node dist/database/verify-m0.js",
    "identity:bootstrap": "node dist/database/bootstrap-identity.js",
    "audit:reconcile": "node dist/audit/reconcile-attempts.js",
    "prisma:seed": "pnpm build && prisma db seed",
    "openapi:export": "node dist/export-openapi.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "services:check": "node dist/check-services.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nexus/shared": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "ioredis": "6.0.0",
    "jose": "6.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "prisma": "7.10.1"
  }
}
